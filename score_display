module score_display(
    input clk,
    input reset,
    input [7:0] score,
    output reg [7:0] digit_enable,
    output [6:0] seg
    );
   
    reg [15:0] scan_timer;
    reg digit_select;
    reg [3:0] current_digit;

    wire [3:0] ones;
    wire [3:0] tens;

    assign ones = score % 10;
    assign tens = score / 10;

    always @(posedge clk or posedge reset)
    begin
        if (reset)
        begin
            scan_timer <= 0;
            digit_select <= 0;
        end
        else
        begin
            if (scan_timer == 16'd50000)
            begin
                scan_timer <= 0;
                digit_select <= ~digit_select;
            end
            else
                scan_timer <= scan_timer + 1;
        end
    end

    always @(*)
    begin
         if (digit_select == 0) begin
            digit_enable = 8'b11111110;
            current_digit = ones;
        end
        else begin
            if (tens == 0)
                digit_enable = 8'b11111111;  // all digits off - blank tens
            else
                digit_enable = 8'b11111101;
            current_digit = tens;
        end
    end

    seven_seg_decoder sevenseg(.digit(current_digit),.seg(seg));
   
endmodule
